# Private Feishu/Lark host, including scheme. Example: https://feishu.intra.example
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=
# Comma-separated document link hosts. The FEISHU_DOMAIN host is added automatically.
# Add your private tenant's document host when it differs from the API host.
FEISHU_DOCUMENT_HOSTS=feishu.cn,my.feishu.cn,larksuite.com,cibt.co.cibfintech.com
# 下发材料不需要固定目录环境变量：每次请求提供模板与材料父文件夹的
# https://<文档域名>/drive/folder/<token> 链接。
# 应用身份需在开发者后台发布 Drive 目录读取/创建/复制、Docx 读写、
# Sheets 读写、Bitable 读写权限；具体权限码见 README。
# User OAuth scopes for Wiki + Sheets + Base. Match scopes enabled in your private app.
# Calendar scopes and offline_access are included automatically during table consent.
FEISHU_TABLE_OAUTH_SCOPES=wiki:node:read sheets:spreadsheet:read sheets:spreadsheet:write_only bitable:app offline_access
# Comma-separated Feishu open_id values allowed to use the bot in direct chats.
# Any member of a group containing the bot can @bot without adding their open_id here.
# FEISHU_ALLOWED_CHATS limits direct chats and cross-chat message_send targets.
# Cross-chat message_send also requires the requester in FEISHU_ALLOWED_USERS.
# DM the bot with /id for your open_id and DM chat_id.
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=

# Personal calendar OAuth. Use your private deployment's endpoints if they differ.
# Register FEISHU_OAUTH_REDIRECT_URI exactly in the app's Security Settings.
FEISHU_OAUTH_AUTHORIZE_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_OAUTH_TOKEN_URL=https://open.feishu.cn/open-apis/authen/v2/oauth/token
FEISHU_OAUTH_REDIRECT_URI=http://localhost:4000/auth/feishu/callback
# The gateway listens here for the OAuth callback; keep it on the local machine.
FEISHU_OAUTH_LISTEN_HOST=localhost
FEISHU_OAUTH_LISTEN_PORT=4000
# Generate a stable random secret (for example, 32 random bytes encoded as base64url).
# Keep it only in .env; changing it invalidates saved user tokens.
FEISHU_TOKEN_ENCRYPTION_KEY=

# Shared by the Feishu Gateway and the registered Agent in Mastra Studio.
# OpenAI-compatible base URL; include /v1 if required, not /chat/completions.
MODEL_PROXY_BASE_URL=http://127.0.0.1:3001/v1
# Accepts either the upstream name or Studio's siliconflow-cn/<upstream-name> form.
# Example: siliconflow-cn/deepseek-ai/DeepSeek-V4.1-Flash
MODEL_PROXY_MODEL=enterprise-model
# Optional if the local proxy authenticates by SSO/session instead of API key.
MODEL_PROXY_API_KEY=
# For https://api.siliconflow.cn/v1 in Studio's SiliconFlow CN model picker,
# set this to the same value as MODEL_PROXY_API_KEY.
SILICONFLOW_CN_API_KEY=

AGENT_DATA_DIR=./data
AGENT_WORKSPACE_DIR=./workspace
# Only explicitly named tools are exposed. Example:
# MCP_SERVERS_JSON={"internal":{"url":"https://mcp.intra.example/mcp","allowedTools":["search"]}}
MCP_SERVERS_JSON={}
MASTRA_TELEMETRY_DISABLED=1
